# ANA Admin — variables de entorno (copiar a .env.local y completar).
# Las NEXT_PUBLIC_* son públicas (van al bundle del navegador): solo
# identificadores, nunca secretos.

# --- Públicas ---
# Pool de Cognito compartido de Pernexium (identificador público).
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-2_UepfOyKpd
# App Client compartido con v4 y las demás apps web (design D2; no es secreto).
NEXT_PUBLIC_COGNITO_CLIENT_ID=1r6niimhkl2fmias6kk85n4ou4
# Apex común con punto en producción; "localhost" en desarrollo.
NEXT_PUBLIC_COOKIE_DOMAIN=localhost
# Canal realtime (add-realtime-admin-web): salida RealtimeWsUrl del stack v4
# (wss://<api>.execute-api.us-east-2.amazonaws.com/<stage>, sin dominio propio).
# Vacío = sin canal (la consola se comporta como antes).
NEXT_PUBLIC_REALTIME_URL=
# "false" apaga el canal sin quitar la URL.
NEXT_PUBLIC_REALTIME_ENABLED=true

# --- Solo servidor (BFF) ---
# Allowlist de `aud` aceptados en el id token, separados por coma.
COGNITO_ALLOWED_CLIENT_IDS=1r6niimhkl2fmias6kk85n4ou4
# Backend v4 (us-east-2).
ANA_V4_API_BASE=https://njpfef2qna.execute-api.us-east-2.amazonaws.com
# Backend v3 (us-east-1).
ANA_V3_API_BASE=https://<api-id>.execute-api.us-east-1.amazonaws.com
# API de Roles de Pernexium.
ROLES_API_BASE=https://<roles-api-host>
ROLES_API_KEY=<llave-de-la-api-de-roles>
