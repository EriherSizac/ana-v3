# Renderer (Vite expone solo VITE_*). User Pool de Pernexium (us-east-2).
VITE_COGNITO_USER_POOL_ID=us-east-2_UepfOyKpd
VITE_COGNITO_CLIENT_ID=1r6niimhkl2fmias6kk85n4ou4
VITE_API_BASE=https://XXXX.execute-api.us-east-2.amazonaws.com

# Main process (Electron). Debe apuntar al mismo backend (URL del deploy).
ANA_API_BASE=https://XXXX.execute-api.us-east-2.amazonaws.com
ANA_SEND_DELAY_MS=4000

# Canal realtime (add-realtime-v4-desktop). URL = salida RealtimeWsUrl del stack v4
# (wss://<api>.execute-api.us-east-2.amazonaws.com/<stage>). En runtime la toma el
# main; al compilar, scripts/write-build-config.mjs la embebe en build-config.json.
# Sin URL no hay conexión (polling de jobs cada 5 s, como antes).
ANA_REALTIME_URL=
# 'off' desactiva el canal en esta PC (polling de 5 s / configuración cada 5 min).
ANA_REALTIME=
