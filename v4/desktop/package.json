{
  "name": "ana-desktop",
  "version": "1.1.3",
  "private": true,
  "description": "ana — app de escritorio (Electron + Vite + React) con whatsapp-web.js",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "dist": "npm run build && electron-builder",
    "publish": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "aws-amplify": "^6.6.0",
    "electron-updater": "^6.3.9",
    "fs-extra": "^11.2.0",
    "qrcode": "^1.5.4",
    "unzipper": "^0.12.3",
    "whatsapp-web.js": "^1.34.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.pernexium.ana",
    "productName": "ana",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/chrome",
        "to": "chrome"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "s3",
        "bucket": "ana-desktop-updates",
        "region": "us-east-2",
        "path": "updates",
        "acl": null
      }
    ]
  }
}
