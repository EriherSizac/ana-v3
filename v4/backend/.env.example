# Secretos (X-Api-Key). Copia a backend/.env (gitignored) con valores reales.
# API externa de Roles & Permisos.
ROLES_API_KEY=
# API de agentes del dashboard (imery) — para repartir contactos por campaña.
DASHBOARD_API_KEY=
# PostgreSQL (campañas). Ej: postgres://user:pass@host:5432/dbname
DATABASE_URL=
# TLS: pega el RDS global CA bundle (PEM) para verificar, o PGSSL_NO_VERIFY=true.
PGSSL_CA=
PGSSL_NO_VERIFY=
# API de interactions del CRM — registro de envíos de campaña (X-Api-Key).
INTERACTIONS_API_KEY=
# user_id del CRM con el que se registran las interacciones.
INTERACTIONS_USER_ID=
# Key del endpoint sistema-a-sistema POST /send (genera una aleatoria larga).
SEND_API_KEY=
